        "Comment",
        "Pourquoi",
        "Combien",
        "Qui"
      ],
      "items": [
        {
          "prompt": "___ allez-vous ? — Très bien, merci.",
          "answer": "Comment"
        },
        {
          "prompt": "___ est la gare ? — Tout droit.",
          "answer": "Où"
        },
        {
          "prompt": "___ de sucre tu veux ? — Deux morceaux.",
