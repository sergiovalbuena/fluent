        },
        {
          "type": "table",
          "head": ["Masculino", "Femenino"],
          "rows": [
            ["*le livre* = el libro", "*la livre* = la libra (medio kilo, moneda)"],
            ["*le tour* = la vuelta, el turno", "*la tour* = la torre"],
            ["*le poste* = el puesto (de trabajo)", "*la poste* = correos"],
            ["*le mode* = el modo", "*la mode* = la moda"],
            ["*le manche* = el mango", "*la manche* = la manga"]
          ]
        },
        {
