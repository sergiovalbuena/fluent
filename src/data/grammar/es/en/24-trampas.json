  "checklist": [
    "I don't say embarazada when I mean embarrassed.",
    "I use en realidad for «actually» and darme cuenta for «realize».",
    "I choose between tú, usted and ustedes, and recognize vos and vosotros.",
    "I recognize the main vocabulary differences between Latin America and Spain."
  ],
  "challenge": {
    "title": "Your trap list",
    "text": "For a week, write down every Spanish word that tricked you because it looked like English, with an example sentence. At the end, teach the list to a friend who's also learning."
  }
