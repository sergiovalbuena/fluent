{
  "slug": "por-para",
  "number": 19,
  "part": 4,
  "level": "B1",
  "title": "Por or para",
  "tagline": "Two words for «for»: the reason behind you, and the goal ahead of you.",
  "goal": "Choose between por and para for purpose, destination, deadlines, causes, exchanges, duration and movement, and learn the fixed expressions.",
  "minutes": 12,
  "sections": [
    {
      "id": "para",
      "title": "Para: looking ahead",
      "blocks": [
        {
          "type": "text",
          "text": "**Para** points forward, to a goal, a destination or a recipient:"
        },
        {
          "type": "table",
          "head": ["Use", "Example", "English"],
          "rows": [
            ["Purpose (+ infinitive)", "*Estudio {para} aprender.*", "in order to"],
            ["Recipient", "*Este regalo es {para} ti.*", "for you"],
            ["Destination", "*Salgo {para} Lima mañana.*", "leaving for"],
            ["Deadline", "*Es {para} el viernes.*", "due by Friday"],
            ["Opinion", "*{Para} mí, es caro.*", "in my opinion"],
            ["Use of an object", "*una taza {para} café*", "a coffee cup"]
          ]
        }
      ]
    },
    {
      "id": "por",
      "title": "Por: looking back, or through",
      "blocks": [
        {
          "type": "text",
          "text": "**Por** looks at the cause, the means or the path:"
        },
        {
          "type": "table",
          "head": ["Use", "Example", "English"],
          "rows": [
            ["Cause, reason", "*Llegué tarde {por} el tráfico.*", "because of"],
            ["Exchange, price", "*Lo compré {por} diez dólares.*", "for ten dollars"],
            ["Duration", "*Estudié {por} dos horas.*", "for two hours"],
            ["Movement through, along", "*Caminamos {por} el parque.*", "through the park"],
            ["Means", "*Hablamos {por} teléfono.*", "on the phone, by"],
            ["Thanks", "*Gracias {por} todo.*", "thanks for"],
            ["Per", "*cien kilómetros {por} hora*", "per hour"]
          ]
        },
        {
          "type": "callout",
          "tone": "tip",
          "title": "The quick test",
          "text": "If you can say «in order to» → *para*. If you can say «because of», «in exchange for» or «through» → *por*."
        }
      ]
    },
    {
      "id": "expresiones",
      "title": "Fixed expressions",
      "blocks": [
        {
          "type": "table",
          "head": ["With por", "With para"],
          "rows": [
            ["*por favor* (please)", "*para siempre* (forever)"],
            ["*por fin* (finally)", "*para nada* (not at all)"],
            ["*por supuesto* (of course)", "*para colmo* (to top it all off)"],
            ["*por ejemplo* (for example)", "*no es para tanto* (it's not a big deal)"],
            ["*por eso* (that's why)", "*para entonces* (by then)"]
          ]
        }
      ]
    }
  ],
