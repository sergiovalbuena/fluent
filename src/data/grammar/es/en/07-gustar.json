        { "prompt": "Me encanta bailar. — A mí ___.", "options": ["también", "tampoco", "sí no"], "answer": "también" },
        { "prompt": "No me gustan las serpientes. — A mí ___.", "options": ["tampoco", "también", "sí"], "answer": "tampoco" }
      ]
    },
    {
      "id": "traduce",
      "section": "final",
      "title": "Say it in Spanish",
      "instructions": "Translate.",
      "kind": "type",
      "speak": "answer",
      "items": [
        { "prompt": "I like dogs.", "answer": "Me gustan los perros." },
        { "prompt": "Do you like dancing? (tú)", "answer": "¿Te gusta bailar?" },
        { "prompt": "My head hurts.", "answer": "Me duele la cabeza." },
        { "prompt": "She loves this song.", "answer": "Le encanta esta canción.", "accept": ["A ella le encanta esta canción."] },
        { "prompt": "Me neither.", "answer": "A mí tampoco.", "accept": ["Yo tampoco."] },
        { "prompt": "The noise bothers me.", "answer": "Me molesta el ruido." }
      ]
    }
  ],
  "checklist": [
    "I use gusta with one thing or a verb and gustan with several things.",
    "I choose me, te, le, nos, les for the person.",
    "I agree with también / tampoco and disagree with sí / no.",
    "I use encantar, doler, molestar and interesar like gustar."
  ],
  "challenge": {
    "title": "Likes and dislikes",
    "text": "Write five things you love, five you don't like, and one thing that bothers you, then ask a friend «¿Y a ti?» for each: *Me encantan los mercados. No me gusta el tráfico. Me molesta el ruido.*"
