        { "prompt": "¿Te ___ bailar?", "answer": "gusta", "explain": "A verb is always singular: gusta." },
        { "prompt": "Nos ___ las películas de terror.", "answer": "gustan" },
        { "prompt": "A Ana le ___ la música.", "answer": "gusta" },
        { "prompt": "A mis hijos les ___ los perros.", "answer": "gustan" }
      ]
    },
    {
      "id": "pronombre",
