      "kind": "choice",
      "items": [
        { "prompt": "___ las once de la noche.", "options": ["Eran", "Fueron", "Son"], "answer": "Eran" },
        { "prompt": "___ mucho frío.", "options": ["Hacía", "Hizo", "Hace"], "answer": "Hacía" },
        { "prompt": "La calle ___ vacía.", "options": ["estaba", "estuvo", "está"], "answer": "estaba" },
        { "prompt": "Yo ___ cansada y ___ dormir.", "options": ["estaba … quería", "estuve … quise", "estoy … quiero"], "answer": "estaba … quería" }
      ]
    },
    {
      "id": "traduce",
