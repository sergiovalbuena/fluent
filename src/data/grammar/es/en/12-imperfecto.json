  "checklist": [
    "I form the imperfect with -aba and -ía.",
    "I know the three irregulars: era, iba, veía.",
    "I use it for habits, descriptions and actions in progress.",
    "I say tenía diez años for past ages."
  ],
  "challenge": {
    "title": "Childhood",
    "text": "Describe your childhood home and a typical Sunday in six sentences with the imperfect: *Vivíamos en una casa pequeña. Los domingos mi papá cocinaba y mi hermana y yo jugábamos en el jardín.*"
