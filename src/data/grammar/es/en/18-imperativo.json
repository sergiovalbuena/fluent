        { "prompt": "___ aquí. (venir)", "answer": "Ven" },
        { "prompt": "___ paciencia. (tener)", "answer": "Ten" },
        { "prompt": "___ la verdad. (decir)", "answer": "Di" },
        { "prompt": "___ las llaves en la mesa. (poner)", "answer": "Pon" },
        { "prompt": "___ este libro. (leer)", "answer": "Lee" }
      ]
    },
    {
      "id": "usted",
      "section": "usted",
      "title": "Usted, ustedes and negatives",
      "instructions": "Choose the right command.",
      "kind": "choice",
      "items": [
        { "prompt": "Señor, ___ a la derecha. (girar, usted)", "options": ["gire", "gira", "giré"], "answer": "gire" },
        { "prompt": "Niños, ___ la mesa. (poner, ustedes)", "options": ["pongan", "ponen", "pongen"], "answer": "pongan" },
        { "prompt": "No ___ tarde. (llegar, tú)", "options": ["llegues", "llegas", "llega"], "answer": "llegues" },
        { "prompt": "¡___ a la playa! (ir, nosotros)", "options": ["Vamos", "Vayamos a", "Íbamos"], "answer": "Vamos" },
        { "prompt": "No ___ tan negativo. (ser, tú)", "options": ["seas", "eres", "sé"], "answer": "seas" },
        { "prompt": "___ su pasaporte, por favor. (mostrar, usted)", "options": ["Muestre", "Muestra", "Mostre"], "answer": "Muestre" }
      ]
    },
    {
      "id": "pronombres",
      "section": "pronombres",
      "title": "Where do the pronouns go?",
      "instructions": "Turn the advice into a command.",
      "kind": "choice",
      "speak": "answer",
      "items": [
        { "prompt": "Tienes que sentarte.", "options": ["Siéntate.", "Te sienta.", "Sientate te."], "answer": "Siéntate." },
        { "prompt": "No tienes que preocuparte.", "options": ["No te preocupes.", "No preocúpate.", "Te no preocupes."], "answer": "No te preocupes." },
        { "prompt": "Tienes que decírmelo.", "options": ["Dímelo.", "Me lo di.", "Di me lo."], "answer": "Dímelo." },
        { "prompt": "Usted debe llamarme.", "options": ["Llámeme.", "Me llame.", "Llama me."], "answer": "Llámeme." },
        { "prompt": "No debes tocarlo.", "options": ["No lo toques.", "No tócalo.", "Lo no toques."], "answer": "No lo toques." }
      ]
    },
    {
      "id": "receta",
      "section": "final",
      "title": "A recipe",
      "instructions": "Recipes use usted. Write the command.",
      "kind": "type",
      "items": [
        { "prompt": "___ el horno a 180 grados. (calentar)", "answer": "Caliente" },
        { "prompt": "___ los huevos en un tazón. (poner)", "answer": "Ponga" },
        { "prompt": "___ el azúcar. (añadir)", "answer": "Añada" },
        { "prompt": "___ bien. (mezclar)", "answer": "Mezcle" },
        { "prompt": "No ___ el horno. (abrir)", "answer": "abra" },
        { "prompt": "___ media hora. (esperar)", "answer": "Espere" }
      ]
    }
  ],
  "checklist": [
    "I give tú commands with the él form, and know di, haz, ve, pon, sal, sé, ten, ven.",
    "I use the subjunctive for usted, ustedes, nosotros and negatives.",
    "I attach pronouns to positive commands (siéntate) and put them first in negatives (no te sientes).",
    "I give directions and recipes with usted."
  ],
  "challenge": {
