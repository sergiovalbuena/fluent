      "title": "Irregular preterites",
      "instructions": "Choose the right form.",
      "kind": "choice",
      "items": [
        { "prompt": "El año pasado ___ a Perú. (ir, yo)", "options": ["fui", "fue", "iba"], "answer": "fui" },
        { "prompt": "¿Qué ___ el fin de semana? (hacer, tú)", "options": ["hiciste", "haciste", "hizo"], "answer": "hiciste" },
        { "prompt": "Mi hermano ___ un accidente. (tener)", "options": ["tuvo", "tenió", "tuvió"], "answer": "tuvo" },
        { "prompt": "Ella me ___ la verdad. (decir)", "options": ["dijo", "dició", "decí"], "answer": "dijo" },
        { "prompt": "No ___ venir. (poder, yo)", "options": ["pude", "podí", "pudé"], "answer": "pude" },
        { "prompt": "Ellos ___ en el restaurante. (estar)", "options": ["estuvieron", "estaron", "estuvon"], "answer": "estuvieron" },
        { "prompt": "La fiesta ___ increíble. (ser)", "options": ["fue", "fui", "era ayer"], "answer": "fue" },
        { "prompt": "Mis amigos ___ vino. (traer)", "options": ["trajeron", "trajieron", "traieron"], "answer": "trajeron" }
      ]
    },
